{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/session-context/session_context.py --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/update-handoff/update_handoff.py --check"
          },
          {
            "type": "command",
            "command": "python scripts/changelog/check_changelog.py --check"
          }
        ]
      }
    ]
  }
}
